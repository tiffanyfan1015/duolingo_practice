{
  "name": "cijian-private",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": { "MULTI_USER": "true" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cijian-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
