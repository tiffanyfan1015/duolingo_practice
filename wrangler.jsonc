{
  "name": "duolingo-vocab",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "duo-vocab.tiffanyfan.com",
      "custom_domain": true
    }
  ],
  "vars": { "MULTI_USER": "true" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "duolingo-vocab-db",
      "database_id": "9a50eaf3-db6f-4029-b1f8-d95b77b41dea"
    }
  ]
}
