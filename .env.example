# Copy to .env and fill locally. Never commit real secrets.
# CREDENTIAL_KEY: 32 random bytes encoded as 64 hexadecimal characters.
# Generate locally: python -c "import secrets; print(secrets.token_hex(32))"
CREDENTIAL_KEY=""
# REGISTRATION_CODE: random invitation code, at least 20 characters.
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(24))"
REGISTRATION_CODE=""
# Wrangler dev reads .env. Do not also create .dev.vars (it takes precedence).
# Production upload is explicit: npx wrangler@4 secret bulk .env
# This uploads to the Worker selected by wrangler.jsonc and deploys the secrets.
